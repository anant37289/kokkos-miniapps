mainmodule lulesh {
    include "lulesh-domain.h";

    readonly CProxy_Main mainProxy;
    readonly CProxy_KokkosManager kokkosProxy;
    readonly CProxy_DomainChare domainProxy;
    readonly int do_atomic;

    message PackingDoneMsg;

    mainchare Main {
        entry Main(CkArgMsg* m);

        entry [reductiontarget] void done();

        entry [reductiontarget] void finalizeDone();

        entry [reductiontarget] void initDone() {
            serial {    
                start = CkWallTimer();
                domainProxy.run();
            }

            when done() {
                serial {
                    printf("Total runtime = %f\n", CkWallTimer() - start);
                    kokkosProxy.finalize();
                    // CkExit();
                }
            }

            when finalizeDone() {
                serial {
                    CkExit();
                }
            }
        };
    };

    nodegroup KokkosManager {
        entry KokkosManager();

        entry void finalize();
    };

    array [3D] DomainChare {
        entry DomainChare(int numRanks, Index_t nx_, int nr_,
            int balance_, int cost_, int showProg_, int quiet_,
            int its_, int viz_, int do_atomic_, 
            int numChares_);

        entry [reductiontarget] void initDone();

        entry void init(int numRanks, Index_t nx, int nr,
                          int balance, int cost, int numChares_) {
            serial "NodalMassComm" {
                // setup commData maps
                CommDataSendInit(*locDom, locDom->sizeX() + 1, locDom->sizeY() + 1, 
                             locDom->sizeZ() + 1, false, false, commDataSendPosVel);
                CommDataSendInit(*locDom, locDom->sizeX() + 1, locDom->sizeY() + 1, 
                             locDom->sizeZ() + 1, true, false, commDataSendSBN);
                CommDataSendInit(*locDom, locDom->sizeX(), locDom->sizeY(), 
                             locDom->sizeZ(), true, true, commDataSendMonoQ);

                CommDataRecvInit(*locDom, locDom->sizeX() + 1, locDom->sizeY() + 1, 
                             locDom->sizeZ() + 1, false, false, commDataRecvPosVel);
                CommDataRecvInit(*locDom, locDom->sizeX() + 1, locDom->sizeY() + 1, 
                             locDom->sizeZ() + 1, true, false, commDataRecvSBN);
                CommDataRecvInit(*locDom, locDom->sizeX(), locDom->sizeY(), 
                             locDom->sizeZ(), true, true, commDataRecvMonoQ);

                CkCallback cb(CkIndex_DomainChare::initDone(), thisProxy);
                contribute(cb);
            }

            when initDone() {
                serial {
                    Kokkos::View<Real_t*> fieldData[1];
                    fieldData[0] = locDom->m_nodalMass;
                    CommSend(*locDom, MSG_COMM_SBN, 1, fieldData, locDom->sizeX() + 1,
                            locDom->sizeY() + 1, locDom->sizeZ() + 1, true, false, commDataSendSBN);

                    recvRef = MAKE_REF(MSG_COMM_SBN, iter);
                    commNbrs = commDataRecvSBN.size();
                    DBG_LITE("[%d,%d,%d] init SBN iter=%u ref=0x%x\n",
                        thisIndex.x, thisIndex.y, thisIndex.z, iter, recvRef);
                }
            }

            for (remoteCount = 0; remoteCount < commNbrs; remoteCount++) {
                when CommRecv[recvRef](uint32_t ref, int x, int y, int z, int xferFields, 
                        int size, nocopydevice Real_t buf[size]) {
                    serial "processRemoteMass" {
                        processRemoteMass(ref, x, y, z, xferFields, size, buf);
                    }
                }
            }
            
            when SBNSendDone() {
                serial {
                    // Increment iter so that the first run() iteration uses different
                    // SDAG reference tags than the init phase, preventing message
                    // misdelivery when timing varies across GPUs.
                    iter++;

                    DBG_LITE("[%d,%d,%d] init DONE iter=%u\n",
                        thisIndex.x, thisIndex.y, thisIndex.z, iter);
                    CkCallback cb(CkIndex_Main::initDone(), mainProxy);
                    contribute(cb);
                }
            }
        };

        entry void packingDone(PackingDoneMsg* msg);
        
        entry [reductiontarget] void TimeStepUpdate(Real_t newdt);

        entry void CommRecv(uint32_t ref, int x, int y, int z, int xferFields, 
            int size, nocopydevice Real_t buf[size]);

        entry void PosVelSendDone();
        entry void MonoQSendDone();
        entry void SBNSendDone();

        entry void PosVelSendCallback();
        entry void MonoQSendCallback();
        entry void SBNSendCallback();

        entry void run() {
            serial "TimeStepCalculation" {
                if(flatIndex==0)
                    printf("running iter %d\n", iter);
                if (locDom->cycle() == 0) {
                    startTime = CkWallTimer();
                }
                if ((opts.showProg != 0) && (opts.quiet == 0) && (flatIndex == 0)) {
                    printf("cycle = %d, time = %e, dt=%e\n", locDom->cycle(),
                             double(locDom->time()), double(locDom->deltatime()));
                    fflush(stdout);

                }

                Real_t gnewdt = TimeStepCalculateLocal(*locDom);

                CkCallback cb(CkReductionTarget(DomainChare, TimeStepUpdate), thisProxy);
                if (sizeof(Real_t) == 4)
                    contribute(sizeof(Real_t), &gnewdt, CkReduction::min_float, cb);
                else
                    contribute(sizeof(Real_t), &gnewdt, CkReduction::min_double, cb);
            }

            when TimeStepUpdate(Real_t newdt) {
                serial "TimeIncrement" {
                    TimeIncrement(newdt);
                }
            }

            serial "CalcForceForNodes" {
                Domain& domain = *locDom;
                CalcForceForNodes(domain, computeSpace);

                Kokkos::View<Real_t*> fieldData[3];
                fieldData[0] = domain.m_fx;
                fieldData[1] = domain.m_fy;
                fieldData[2] = domain.m_fz;
                CommSend(domain, MSG_COMM_SBN, 3, fieldData, domain.sizeX() + 1,
                         domain.sizeY() + 1, domain.sizeZ() + 1, true, false, commDataSendSBN);
                
                recvRef = MAKE_REF(MSG_COMM_SBN, iter);
                commNbrs = commDataRecvSBN.size();
                DBG_LITE("[%d,%d,%d] SBN iter=%u ref=0x%x\n",
                    thisIndex.x, thisIndex.y, thisIndex.z, iter, recvRef);
            }

            for (remoteCount = 0; remoteCount < commNbrs; remoteCount++) {
                when CommRecv[recvRef](uint32_t ref, int x, int y, int z, int xferFields, 
                        int size, nocopydevice Real_t buf[size]) {
                    serial "processRemoteForce" {
                        processRemoteForce(ref, x, y, z, xferFields, size, buf);
                    }
                }
            }

            serial "AfterForceRecv" {
                //applyBufferedForce();
            }

            serial "LagrangeNodal" {
                Domain& domain = *locDom;
                const Real_t delt = domain.deltatime();
                Real_t u_cut = domain.u_cut();
                
                CalcAccelerationForNodes(domain, domain.numNode(), computeSpace);

                ApplyAccelerationBoundaryConditionsForNodes(domain, computeSpace);

                CalcVelocityForNodes(domain, delt, u_cut, domain.numNode(), computeSpace);

                CalcPositionForNodes(domain, delt, domain.numNode(), computeSpace);
            }

            when SBNSendDone() {
                serial {
                    Domain &domain = *locDom;

                    Kokkos::View<Real_t*> fieldData[6];
                    fieldData[0] = domain.m_x;
                    fieldData[1] = domain.m_y;
                    fieldData[2] = domain.m_z;
                    fieldData[3] = domain.m_xd;
                    fieldData[4] = domain.m_yd;
                    fieldData[5] = domain.m_zd;
                    CommSend(domain, MSG_SYNC_POS_VEL, 6, fieldData, domain.sizeX() + 1,
                            domain.sizeY() + 1, domain.sizeZ() + 1, false, false, commDataSendPosVel);

                    recvRef = MAKE_REF(MSG_SYNC_POS_VEL, iter);
                    commNbrs = commDataRecvPosVel.size();
                    DBG_LITE("[%d,%d,%d] PosVel iter=%u ref=0x%x\n",
                        thisIndex.x, thisIndex.y, thisIndex.z, iter, recvRef);
                }
            }

            for (remoteCount = 0; remoteCount < commNbrs; remoteCount++) {
                when CommRecv[recvRef](uint32_t ref, int x, int y, int z, int xferFields, 
                        int size, nocopydevice Real_t buf[size]) {
                    serial "processRemotePosVel" {
                        processRemotePosVel(ref, x, y, z, xferFields, size, buf);
                    }
                }
            }

            serial "AfterPosVelRecv" {
                //applyBufferedPosVel();
                // Kokkos::fence();
            }

            serial "LagrangeElements" {
                Domain& domain = *locDom;
                CalcLagrangeElements(domain, computeSpace);
                CalcQForElems(domain, computeSpace);
            }

            when PosVelSendDone() {
                serial {
                    Domain &domain = *locDom;

                    Kokkos::View<Real_t*> fieldData[3];
                    fieldData[0] = domain.m_delv_xi;
                    fieldData[1] = domain.m_delv_eta;
                    fieldData[2] = domain.m_delv_zeta;
                    
                    //printf("SENDING Q\n");
                    fflush(stdout);
                    CommSend(domain, MSG_MONOQ, 3, fieldData, domain.sizeX(), domain.sizeY(),
                            domain.sizeZ(), true, true, commDataSendMonoQ);

                    recvRef = MAKE_REF(MSG_MONOQ, iter);
                    commNbrs = commDataRecvMonoQ.size();
                    DBG_LITE("[%d,%d,%d] MonoQ iter=%u ref=0x%x\n",
                        thisIndex.x, thisIndex.y, thisIndex.z, iter, recvRef);
                }
            }

            for (remoteCount = 0; remoteCount < commNbrs; remoteCount++) {
                when CommRecv[recvRef](uint32_t ref, int x, int y, int z, int xferFields, 
                        int size, nocopydevice Real_t buf[size]) {
                    serial "processRemoteQ" {
                        processRemoteQ(ref, x, y, z, xferFields, size, buf);
                    }
                }
            }

            serial "AfterQRecv" {
                // Kokkos::fence();
                // I am not sure if ordering this will be as much of a help and why the ordering earlier is a help at all??
                // so the ordering code with process and the apply is removed
                // maybe its because of this is using only copy1D for some reason...   
            }

            serial "LagrangeElementsPost" {
                Domain &domain = *locDom;
                CalcMonotonicQForElems(domain, computeSpace);

                // domain.DeallocateGradients();

                CheckQStop(domain, computeSpace);

                ApplyMaterialPropertiesForElems(domain, computeSpace);

                UpdateVolumesForElems(domain, domain.v_cut(), domain.numElem(), computeSpace);

                CalcTimeConstraintsForElems(domain, computeSpace);

                if(flatIndex==0 && opts.showProg)
                    PrintState(*locDom, flatIndex);

                iter++;
                DBG_LITE("[%d,%d,%d] DONE iter=%u\n",
                    thisIndex.x, thisIndex.y, thisIndex.z, iter);
            }

            when MonoQSendDone() {
                serial {
                    // run next iteration
                    if ((locDom->time() < locDom->stoptime()) && (locDom->cycle() < opts.its)) {
                        thisProxy[thisIndex].run();
                    } else {
                        if (thisIndex.x == 0 && thisIndex.y == 0 && thisIndex.z == 0) {
                            Real_t elapsed_time = CkWallTimer() - startTime;
                            VerifyAndWriteFinalOutput(elapsed_time, *locDom, locDom->sizeX(), locDom->numRanks());
                        }
                        // delete locDom;
                        // locDom = nullptr;
                        CkCallback cb(CkReductionTarget(Main, done), mainProxy);
                        contribute(cb);
                    }
                }
            }
        };
    };
};